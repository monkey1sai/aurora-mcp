{
  "$schema": "https://unpkg.com/wrangler@4.133.0/config-schema.json",
  "name": "aurora-mcp",
  "main": "mcp/cloud-worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node tools/build-mcp-site.mjs" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/mcp", "/jobs/*", "/rooms", "/rooms/*", "/health"], "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "JOBS", "class_name": "RenderJob" }, { "name":"BUDGET", "class_name":"AdmissionBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RenderJob"] }, {"tag":"v2", "new_sqlite_classes":["AdmissionBudget"]}],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
