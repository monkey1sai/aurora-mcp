{
  "name": "aurora-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "lan": "node tools/serve.mjs --lan",
    "test": "node tools/test.mjs",
    "render": "node tools/render.mjs",
    "build": "node tools/build-mcp-site.mjs",
    "mcp:stdio": "node mcp/stdio.mjs",
    "mcp:http": "node mcp/http.mjs",
    "test:mcp": "node --test mcp/test/*.test.mjs",
    "deploy": "npx wrangler@4.133.0 deploy --config wrangler.mcp.jsonc",
    "mcp:cloud:dev": "npx wrangler@4.133.0 dev --config wrangler.mcp.jsonc --local"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monkey1sai/aurora-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
